:root {
  --bg: #f7f7f5; --card: #ffffff; --text: #1d1d1f; --muted: #6b6b70; --line: #e3e3e0;
  --accent: #2f5fb3; --start: #1f7a4d; --start-bg: #e3f4ea; --up: #7a5a1f; --up-bg: #f6eedc;
  --warn-bg: #fff4d6; --warn: #6b5200; --bad: #9b2c2c; --ref: #5c5c62; --ref-bg: #ececea;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #141416; --card: #1d1d20; --text: #ececee; --muted: #a0a0a8; --line: #2e2e33;
    --accent: #8ab0ff; --start: #7fd6a4; --start-bg: #173326; --up: #e6c27a; --up-bg: #3a2f17;
    --warn-bg: #3a3214; --warn: #f1d77a; --bad: #ff9a9a; --ref: #b4b4bc; --ref-bg: #2c2c31;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text);
  font: 15px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
header, main, footer { max-width: 760px; margin: 0 auto; padding: 0 16px; }
header { padding-top: 18px; }
h1 { font-size: 1.35rem; margin: 0 0 2px; }
h2 { font-size: 1.1rem; margin: 22px 0 8px; }
h3 { font-size: 1rem; margin: 0 0 6px; display: flex; justify-content: space-between; align-items: baseline; }
.meta, .count, .sub, small, .note, .hidden-note { color: var(--muted); }
.count { font-size: .85rem; font-weight: normal; }
.banner { background: var(--warn-bg); color: var(--warn); border-radius: 8px; padding: 8px 10px; margin: 8px 0; font-size: .9rem; }
.card, .slot { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 12px; margin-bottom: 10px; }
ul { list-style: none; margin: 0; padding: 0; }
.row { display: grid; grid-template-columns: 1fr auto; gap: 2px 10px; padding: 8px 0; }
li.item { border-top: 1px solid var(--line); }
li.item:first-child { border-top: 0; }
.bd > summary { list-style: none; cursor: pointer; }
.bd > summary::-webkit-details-marker { display: none; }
.bd > summary .name::before { content: "▸ "; color: var(--muted); font-weight: normal; }
.bd[open] > summary .name::before { content: "▾ "; }
.bdbody { padding: 2px 0 10px 14px; font-size: .88rem; }
.part { padding: 3px 0; }
.part.missing { color: var(--muted); }
.mini > summary { list-style: none; cursor: pointer; color: var(--accent); font-size: .85rem; }
.mini > summary::-webkit-details-marker { display: none; }
.name { font-weight: 600; }
.sub { font-size: .85rem; }
.pts { text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; }
.pts small { font-weight: normal; margin-left: 2px; }
.tag, .chip { display: inline-block; font-size: .72rem; border-radius: 999px; padding: 1px 7px; margin-left: 4px;
  border: 1px solid var(--line); color: var(--muted); vertical-align: 1px; }
.tag.q { color: var(--warn); border-color: var(--warn); }
.tag.bad { color: var(--bad); border-color: var(--bad); }
.chip.start { background: var(--start-bg); color: var(--start); border-color: transparent; font-weight: 700; }
.chip.upgrade { background: var(--up-bg); color: var(--up); border-color: transparent; font-weight: 700; }
.sugg { padding: 8px 0 2px; border-top: 1px dashed var(--line); font-size: .92rem; }
.sugg.ref { color: var(--ref); }
.chip.ref { background: var(--ref-bg); color: var(--ref); border-color: transparent; font-weight: 700; }
.why { font-size: .85rem; font-style: italic; }
.res { display: block; font-size: .8rem; font-weight: 600; color: var(--text); }
.res.live { color: var(--warn); }
.res.dnp { color: var(--muted); font-weight: normal; }
.out { font-weight: 700; }
.out.hit { color: var(--start); } .out.miss { color: var(--bad); } .out.push { color: var(--muted); }
.card.played { opacity: .95; border-style: dashed; }
.weeks { display: flex; gap: 6px; overflow-x: auto; padding: 4px 0 8px; margin: 6px 0 0; }
.weeks a { flex: none; padding: 4px 10px; border-radius: 999px; border: 1px solid var(--line); background: var(--card);
  color: var(--text); text-decoration: none; font-size: .85rem; }
.weeks a.here { background: var(--accent); color: var(--card); border-color: var(--accent); font-weight: 700; }
.pastweek { background: var(--ref-bg); color: var(--text); border-radius: 8px; padding: 8px 10px; margin: 8px 0; font-size: .9rem; }
.tabs > input { position: absolute; opacity: 0; pointer-events: none; }
.tabs > label { display: inline-block; padding: 8px 16px; margin-right: 6px; border-radius: 999px; cursor: pointer;
  border: 1px solid var(--line); background: var(--card); font-weight: 600; }
.tabs > input:focus-visible + label { outline: 2px solid var(--accent); outline-offset: 2px; }
.tabpanel { display: none; margin-top: 12px; }
{% for slot in slots %}#tab-{{ slot }}:checked + label { background: var(--accent); color: var(--card); border-color: var(--accent); }
#tab-{{ slot }}:checked ~ #panel-{{ slot }} { display: block; }
{% endfor %}
.tierhead { font-size: .8rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: 0 0 2px; }
table { width: 100%; border-collapse: collapse; font-size: .85rem; }
td, th { text-align: left; padding: 4px 6px; border-top: 1px solid var(--line); overflow-wrap: anywhere; }
footer { padding-bottom: 30px; font-size: .85rem; }
a { color: var(--accent); }
