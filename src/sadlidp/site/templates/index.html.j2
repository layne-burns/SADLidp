<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SADL IDP Streamer</title>
<style>
{% include "_style.j2" %}
</style>
</head>
<body>
{%- macro opp(p) -%}{% if p.opp %}{% if p.opp.startswith('@') %}@ {{ p.opp[1:] }}{% else %}vs {{ p.opp }}{% endif %}{% endif %}{%- endmacro %}
{%- macro tags(p) -%}
{% for a in p.also %}<span class="tag">also {{ a }}</span>{% endfor %}
{% if 'Q' in p.flags %}<span class="tag q">Q</span>{% endif %}
{% for f in p.flags if f != 'Q' %}<span class="tag q">{{ f }}</span>{% endfor %}
{% for r in p.unavailable %}<span class="tag bad">{{ r }}</span>{% endfor %}
{%- endmacro %}
{%- macro chip(b) -%}{% if b.reference %}<span class="chip ref">{{ b.badge }} · ref</span>{% else %}<span class="chip {{ b.badge|lower }}">{{ b.badge }}</span>{% endif %}{%- endmacro %}
{%- macro pts(p) -%}{% if p.mu is not none %}{{ '%.1f'|format(p.mu) }}{% if p.late %}<sup title="projection captured after kickoff">*</sup>{% endif %}{% if p.sigma is not none %}<small>±{{ '%.1f'|format(p.sigma) }}</small>{% endif %}{% else %}<small>no projection</small>{% endif %}{{ result(p.result) }}{% if p.floor is defined and p.floor is not none and not p.result %}<div class="band" title="one game in five lands below the floor, one in five above the ceiling">{{ '%.0f'|format(p.floor) }}–{{ '%.0f'|format(p.ceiling) }}</div>{% endif %}{%- endmacro %}
{%- macro result(r) -%}{% if r %}{% if r.state == 'final' %}<span class="res">scored {{ '%.1f'|format(r.pts) }}</span>{% elif r.state == 'live' %}<span class="res live">{{ '%.1f'|format(r.pts) }} so far</span>{% elif r.state == 'unavailable' %}<span class="res dnp">score unavailable</span>{% else %}<span class="res dnp">did not play</span>{% endif %}{% endif %}{%- endmacro %}
{%- macro card_open(p) -%}{% if p.breakdown %}<li class="item"><details class="bd"><summary><div class="row">{% else %}<li class="item"><div class="row">{% endif %}{%- endmacro %}
{%- macro card_close(p) -%}{% if p.breakdown %}</div></summary>{{ bdbody(p) }}</details></li>{% else %}</div></li>{% endif %}{%- endmacro %}
{%- macro bdbody(p) -%}{% if p.breakdown %}<div class="bdbody">
{% for part in p.breakdown.parts %}{% if part.missing %}<div class="part missing"><b>{{ part.source }}</b> · {{ part.missing }}</div>
{% else %}<div class="part"><b>{{ part.source }}</b> · {{ '%.1f'|format(part.pts) }} pts{% if part.share is not none %} · {{ (part.share * 100)|round|int }}% of his number{% endif %}{% if part.zero %} · not on its list, so it counts as 0{% endif %}{% if part.rank is defined and part.rank is not none %} · {% if part.censored %}not on its {{ part.list }} list, so ranked just past its end (#{{ part.rank }}){% else %}{{ part.list }} rank #{{ part.rank }}{% endif %}{% endif %}{% if part.late %} · captured after kickoff{% endif %}
{% if part.stats %}<div class="sub">{% for st in part.stats %}{{ '%.1f'|format(st[1]) }} {{ st[0] }}{% if st[2] %}*{% endif %}{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}</div>
{% endif %}{% endfor %}
{% if p.breakdown.form %}{% set f = p.breakdown.form %}<div class="part"><b>Form</b> · {{ '%+.1f'|format(f.pts) }} pts
{% if f.miss %}<div class="sub">{{ 'beat' if f.miss.mean >= 0 else 'trailed' }} his projection by {{ '%.1f'|format(f.miss.mean|abs) }} per game over {{ f.miss.games }} game{{ 's' if f.miss.games != 1 }} this season, counted as {{ '%+.1f'|format(f.miss.shrunk) }} after shrinking: {{ '%+.1f'|format(f.miss.pts) }}</div>{% endif %}
{% if f.snap %}<div class="sub">{{ (f.snap.share * 100)|round|int }}% of his team's defensive snaps last game (week {{ f.snap.week }}), against {{ (f.snap.avg * 100)|round|int }}% for the position's 60 best-projected: {{ '%+.1f'|format(f.snap.pts) }}</div>{% endif %}
</div>
{% endif %}{% if p.breakdown.mu is not none %}{% set kinds = p.breakdown.parts|selectattr('kind', 'defined')|map(attribute='kind')|unique|list %}<div class="sub">Weighted average = {{ '%.1f'|format(p.breakdown.base if p.breakdown.form else p.breakdown.mu) }} pts{% if kinds|length == 1 %} (from {{ 'projections' if kinds[0] == 'projection' else 'rankings' }} only this week){% endif %}{% if p.breakdown.form %}; with form {{ '%+.1f'|format(p.breakdown.form.pts) }} = {{ '%.1f'|format(p.breakdown.mu) }} pts{% endif %}.</div>{% endif %}
{% if p.breakdown.est %}<div class="sub">* = our estimate (the source doesn't project that stat)</div>{% endif %}
{% if p.swing is defined and p.swing is not none and not p.result %}<div class="sub">Game-to-game swing ±{{ '%.1f'|format(p.swing) }} from his projected stat mix (big-ticket stats such as sacks swing more): 3 games in 5 land between {{ '%.0f'|format(p.floor) }} and {{ '%.0f'|format(p.ceiling) }}.</div>{% endif %}
</div>{% endif %}{%- endmacro %}
{%- macro outcome(s) -%}{% if s.outcome == 'hit' %}<div class="out hit">✓ paid off</div>{% elif s.outcome == 'miss' %}<div class="out miss">✗ didn't pay off</div>{% elif s.outcome == 'push' %}<div class="out push">= tied</div>{% elif s.outcome == 'void' %}<div class="out push">— void (one of them didn't play)</div>{% endif %}{%- endmacro %}
{%- macro pts_text(r) -%}{% if r %}{% if r.state == 'final' %}scored {{ '%.1f'|format(r.pts) }}{% elif r.state == 'live' %}{{ '%.1f'|format(r.pts) }} so far{% elif r.state == 'unavailable' %}score unavailable{% else %}did not play{% endif %}{% else %}not played yet{% endif %}{%- endmacro %}
<header>
  <h1>SADL IDP streamer</h1>
  <p class="meta"><a href="stats.html">How the numbers did →</a></p>
  <p class="meta">{{ d.league.name }} · {{ d.season }} Week {{ d.week }} · data as of <time id="asof" datetime="{{ d.generated_at }}">{{ d.generated_at|et }}</time> · {{ d.league.waiver_type }} waivers</p>
  {% if nav and nav|length > 1 %}<nav class="weeks" aria-label="Weeks">{% for n in nav %}<a href="{{ n.href }}"{% if (n.season, n.week) == here %} class="here" aria-current="page"{% endif %}>{{ n.label }}{% if n.latest %} · now{% endif %}</a>{% endfor %}</nav>{% endif %}
  {% if d.replayed %}<p class="pastweek">{{ d.replayed.note }}</p>{% endif %}
  {% if not latest %}<p class="pastweek">You're looking at a past week. {% if final %}{% if final.provisional %}Scores are provisional (stat corrections still possible).{% else %}All scores are final.{% endif %}{% else %}Final stats weren't captured for this week, so scores are as of the last sync.{% endif %}{% if not d.replayed %} Suggestions and tiers are as they stood at the week's last sync.{% endif %}</p>{% endif %}
  <p id="stale" class="banner" hidden>This data is more than 36 hours old. Run <b>sync</b> in the repo's Actions tab to refresh.</p>
  {% for w in d.warnings %}<p class="banner">{{ w }}</p>{% endfor %}
  {% if d.last_week and d.last_week.summary.decided %}<p class="meta"><a href="#lw-h">Last week: {{ d.last_week.summary.hits }} of {{ d.last_week.summary.decided }} suggestions paid off ↓</a></p>{% endif %}
</header>
<main>
  <section aria-labelledby="my-h">
    <h2 id="my-h">My IDPs</h2>
    {% for slot in slots %}{% set m = d.my_idps[slot] %}
    <div class="slot">
      <h3>{{ slot }} <span class="count">{{ m.count }}/{{ m.limit }} rostered</span></h3>
      <ul>
        {% for p in m.players %}
        {{ card_open(p) }}
          <div><span class="name">{{ p.name }}</span>
            {% if p.role == 'starter' %}<span class="tag">projected starter</span>{% endif %}
            {% if p.reserve %}<span class="tag">IR</span>{% endif %}{% if p.taxi %}<span class="tag">taxi</span>{% endif %}
            {{ tags(p) }}
            <div class="sub">{{ p.team or 'FA' }} {{ opp(p) }}{% if 'locked' not in p.unavailable %} · {{ p.tier|tier(d.positions[slot].tier_count) }}{% endif %}</div></div>
          <div class="pts">{{ pts(p) }}</div>
{{ card_close(p) }}
        {% else %}<li class="item"><div class="row"><span class="sub">No {{ slot }} rostered</span></div></li>{% endfor %}
      </ul>
      {% if m.starter_locked %}<p class="note">Your {{ slot }} starter's game has started, so suggestions here are for reference.</p>{% endif %}
      {% for s in m.suggestions %}
      <div class="sugg{% if s.reference %} ref{% endif %}">
        {{ chip(s) }}
        <b>{{ s.player.name }}</b> <span class="sub">{{ s.player.team }} {{ opp(s.player) }}</span>
        · {{ '%.1f'|format(s.player.mu) }} pts{% if s.over %}, {{ [(s.p * 100)|round|int, 99]|min }}% to outscore {{ m.names.get(s.over, 'your player') }}{% else %}; you have no playable {{ slot }} this week{% endif %}.
        {% if latest is not defined or latest %}<div class="sub">{{ action(s, m.names) }}</div>
        {% if s.reference %}<div class="why">For reference: {{ why(s, m.names, slot) }}.</div>{% endif %}{% endif %}
        {% if s.player.breakdown %}<details class="mini"><summary>sources ▾</summary>{{ bdbody(s.player) }}</details>{% endif %}
        {% if s.player.result %}<div class="sub">Result: {{ pts_text(s.player.result) }}{% if s.over %} vs {{ m.names.get(s.over, 'your player') }} {{ pts_text(s.over_result) }}{% endif %}</div>{{ outcome(s) }}{% endif %}
      </div>
      {% endfor %}
      {% if m.played_suggestions %}
      <p class="tierhead" style="margin-top:10px">This week's suggestions that have played</p>
      {% for s in m.played_suggestions %}
      <div class="sugg">
        {{ chip(s) }} <b>{{ s.player.name }}</b> <span class="sub">{{ s.player.team }} {{ opp(s.player) }}</span>
        · projected {{ '%.1f'|format(s.player.mu) }}, {{ pts_text(s.player.result) }}
        {% if s.over %}<div class="sub">vs {{ m.names.get(s.over, 'your player') }}: projected {{ '%.1f'|format(s.mu_over or 0) }}, {{ pts_text(s.over_result) }}</div>{% endif %}
        {{ outcome(s) }}
      </div>
      {% endfor %}
      {% if m.played_suggestions_hidden %}<p class="hidden-note">{{ m.played_suggestions_hidden }} more not shown.</p>{% endif %}
      {% endif %}
    </div>
    {% endfor %}
  </section>

  <section aria-labelledby="tiers-h">
    <h2 id="tiers-h">Streaming tiers (available players)</h2>
    <div class="tabs">
      {% for slot in slots %}<input type="radio" name="pos" id="tab-{{ slot }}"{% if loop.first %} checked{% endif %}><label for="tab-{{ slot }}">{{ slot }}</label>{% endfor %}
      {% for slot in slots %}{% set pos = d.positions[slot] %}
      <div class="tabpanel" id="panel-{{ slot }}">
        {% for t in pos.tiers %}
        <div class="card">
          <p class="tierhead">Tier {{ t.tier }}</p>
          <ul>
            {% for p in t.players %}
            {{ card_open(p) }}
              <div><span class="name">{{ p.name }}</span>
                {% if p.badge %}{{ chip(p.badge) }}{% endif %}
                {{ tags(p) }}
                <div class="sub">{{ p.team }} {{ opp(p) }}{% if p.n > 1 %} · range {{ '%.1f'|format(p.min) }}–{{ '%.1f'|format(p.max) }} ({{ p.n }} sources){% endif %}</div></div>
              <div class="pts">{{ pts(p) }}</div>
{{ card_close(p) }}
            {% endfor %}
          </ul>
        </div>
        {% else %}<p class="note">No available {{ slot }} with a projection this week.</p>{% endfor %}
        {% if pos.hidden > 0 %}<p class="hidden-note">{{ pos.hidden }} more available {{ slot }} not shown.</p>{% endif %}
        {% if pos.no_projection > 0 %}<p class="hidden-note">{{ pos.no_projection }} available {{ slot }} {{ 'has' if pos.no_projection == 1 else 'have' }} no projection this week.</p>{% endif %}
        {% if pos.played %}
        <div class="card played">
          <p class="tierhead">Already played this week</p>
          <ul>
            {% for p in pos.played %}
            {{ card_open(p) }}
              <div><span class="name">{{ p.name }}</span>
                <div class="sub">{{ p.team }} {{ opp(p) }} · {{ ('Tier ' ~ p.tier ~ ' before kickoff') if p.tier else 'not tiered before kickoff' }}</div></div>
              <div class="pts">{{ pts(p) }}</div>
{{ card_close(p) }}
            {% endfor %}
          </ul>
          {% if pos.played_hidden > 0 %}<p class="hidden-note">{{ pos.played_hidden }} more not shown.</p>{% endif %}
        </div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </section>
  {% set lw = d.last_week %}
  {% if lw and (lw.slots.DL or lw.slots.LB or lw.slots.DB) %}
  <section aria-labelledby="lw-h">
    <h2 id="lw-h">Last week's suggestions (week {{ lw.week }})</h2>
    <div class="slot">
      <p class="note">{% if lw.summary.decided %}{{ lw.summary.hits }} of {{ lw.summary.decided }} suggestions paid off (the suggested player outscored the one he was compared with).{% else %}No suggestions were decided.{% endif %}
        {% if lw.provisional %}Scores are provisional until stat corrections close {{ lw.settles|et }}.{% else %}Final scores.{% endif %}</p>
      {% for slot in slots %}{% for s in lw.slots[slot] %}
      <div class="sugg{% if s.reference %} ref{% endif %}">
        {{ chip(s) }} <b>{{ s.name }}</b> <span class="sub">{{ s.team or '' }} · {{ slot }}</span>
        · projected {{ '%.1f'|format(s.mu_w) }}, {{ pts_text(s.result) }}
        {% if s.over %}<div class="sub">vs {{ s.over_name }}: projected {{ '%.1f'|format(s.mu_over or 0) }}, {{ pts_text(s.over_result) }}</div>{% endif %}
        {{ outcome(s) }}
        {% if s.reference %}<div class="why">Shown for reference at the time; not counted.</div>{% endif %}
      </div>
      {% endfor %}{% endfor %}
    </div>
  </section>
  {% endif %}
</main>
<footer>
  <h2>Sources</h2>
  <div class="scroll"><table class="sources">
    <tr><th>Source</th><th>Status</th><th>Players</th><th>Matched</th><th>Last success</th></tr>
    {% for name, s in d.sources.items() %}
    <tr><td>{{ s.label or name }}</td><td>{{ 'from saved data' if s.status == 'saved' else s.status }}{% if s.stale %} (stale, not used){% endif %}</td>
      <td>{{ s.rows_used }}{% if s.no_projection %} <small>+{{ s.no_projection }} without a projection</small>{% endif %}</td>
      <td>{% if s.match and s.match.rate is not none %}{{ '%.1f'|format(s.match.rate * 100) }}%{% if s.match.unmatched %}{% if s.match.names %}<details class="mini"><summary>{{ s.match.unmatched }} unmatched</summary><small>{{ s.match.names|join(', ') }}</small></details>{% else %} <small>{{ s.match.unmatched }} unmatched</small>{% endif %}{% endif %}{% else %}—{% endif %}</td>
      <td>{{ s.last_success|et }}</td></tr>
    {% endfor %}
  </table></div>
  <p>Points are SADL scoring. ± is how much the sources disagree, not game-to-game luck; START/UPGRADE odds include game-to-game swing{% if d.swing %}, each player's own from his projected stat mix (the small floor–ceiling under his points: one game in five below, one in five above), or{% endif %} the position's typical spread (σ<sub>out</sub> DL {{ d.sigma_out.DL }}, LB {{ d.sigma_out.LB }}, DB {{ d.sigma_out.DB }}).
  Tiers group players statistically indistinguishable from each tier's best.
  Form: once a player has played this season, his number also carries his earlier misses (shrunk toward 0) and his last game's share of his team's defensive snaps; tap him to see both.
  Matched: the share of a source's players with an NFL team that were matched to a Sleeper player (unmatched ones are listed, never dropped silently).
  * Projection first captured after kickoff, so it can't be proven pre-game; Sleeper's projections haven't been seen to change once games start. Scores are SADL points from Sleeper's stats: "so far" while a game is on, final 4 hours after kickoff. <a href="{{ data_href or 'data.json' }}">data.json</a></p>
</footer>
{% if latest is not defined or latest %}<script>
(function () {
  var t = document.getElementById("asof");
  var age = (Date.now() - Date.parse(t.getAttribute("datetime"))) / 36e5;
  if (age > 36) document.getElementById("stale").hidden = false;
})();
</script>{% endif %}
</body>
</html>
